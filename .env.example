# ======== SubHub 节点配置 ========
# 管理员登录密码
ADMIN_PASSWORD=your_password_here
# 服务端口
PORT=3456
# Cookie 加密密钥（随机字符串）
COOKIE_SECRET=change_me_to_random_string

# ======== s-ui 桥接配置 ========
# s-ui 桥接服务地址（日本服务器的 s-ui-bridge）
SUI_BRIDGE_URL=http://your-sui-server:9876
# s-ui 桥接认证 Token
SUI_BRIDGE_TOKEN=subhub_bridge_change_me

# ======== 大陆 Ping API（路由器 frpc 转发） ========
# 部署在家庭路由器上的 ping_api.py 通过 frpc 暴露到本服务器
CHINA_PING_URL=http://ai.ranxiaoer.com:9877
CHINA_PING_TOKEN=subhub_ping_2026
